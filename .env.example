# Edge function secrets: copy to .env, fill in, then `supabase secrets set --env-file .env`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase; don't set them here.

# verify-glass and sms-glass
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-robotics-er-2-preview

# verify-glass: callers send this in the ROBOT_API_KEY header
ROBOT_API_KEY=
# VERIFY_MAX_PER_HOUR=60

# sms-glass
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
REPORTER_SALT=
# SMS_WEBHOOK_URL=https://<project-ref>.supabase.co/functions/v1/sms-glass

# request-demo
DEMO_SALT=
# DEMO_ALLOWED_ORIGINS=https://example.com,https://staging.example.com
